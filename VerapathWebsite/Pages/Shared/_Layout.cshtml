    <style id="vp-layout-css">
        /* ── Nav scroll transition ── */
        #vp-nav {
            transition: background-color 0.3s ease, backdrop-filter 0.3s ease,
                        -webkit-backdrop-filter 0.3s ease, border-color 0.3s ease;
        }
        #vp-nav.vp-nav-hero {
            background-color: transparent;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            border-bottom-color: transparent;
        }
        /* Logo swap */
        #vp-nav-logo .logo-light { display: none; }
        #vp-nav.vp-nav-hero #vp-nav-logo .logo-dark  { display: none; }
        #vp-nav.vp-nav-hero #vp-nav-logo .logo-light { display: block; }
        /* Light text + active link + hamburger lines */
        #vp-nav.vp-nav-hero #vp-nav-links a { color: rgba(255,255,255,0.9); }
        #vp-nav.vp-nav-hero #vp-nav-links a[data-framer-page-link-current="true"] { color: rgb(163,233,107); }
        #vp-nav.vp-nav-hero #vp-nav-hamburger span { background-color: rgba(255,255,255,0.9); }

        /* ── Hide Framer's SSR nav and footer (replaced by layout nav/footer below) ── */
        .framer-iR7wg,
        .framer-YlVOa { display: none !important; }

        /* ── Shared nav ── */
        #vp-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            background-color: rgba(248, 248, 243, 0.85);
            border-bottom: 1px solid rgba(59, 59, 51, 0.2);
        }
        #vp-nav-inner {
            max-width: 1366px;
            margin: 0 auto;
            padding: 0 32px;
            height: 68px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        /* Logo — left edge */
        #vp-nav-left {
            display: flex;
            align-items: center;
            z-index: 1;
        }
        #vp-nav-logo img {
            height: 28px;
            width: auto;
            display: block;
        }
        /* Links — absolutely centered in the bar */
        #vp-nav-center {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }
        #vp-nav-links {
            display: flex;
            align-items: center;
            gap: 40px;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        #vp-nav-links a {
            font-family: "Season Sans Regular", "Season Sans Regular Placeholder", Arial, sans-serif;
            font-size: 15px;
            color: #3b3b33;
            text-decoration: none;
            letter-spacing: -0.01em;
            transition: color 0.3s ease, opacity 0.3s ease;
        }
        #vp-nav-links a:hover { opacity: 0.55; }
        #vp-nav-links a[data-framer-page-link-current="true"] { color: rgb(14, 166, 101); }
        /* CTA + hamburger — right edge */
        #vp-nav-right {
            display: flex;
            align-items: center;
            gap: 16px;
            z-index: 1;
        }
        #vp-nav-cta {
            font-family: "Season Sans SemiBold", "Season Sans Regular Placeholder", Arial, sans-serif;
            font-size: 14px;
            font-weight: 650;
            color: #223029;
            text-decoration: none;
            background-color: rgb(163, 233, 107);
            border-radius: 6px;
            padding: 9px 20px;
            white-space: nowrap;
            transition: opacity 0.2s ease;
        }
        #vp-nav-cta:hover { opacity: 0.85; }
        #vp-nav-hamburger {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            width: 36px;
            height: 36px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px;
            flex-shrink: 0;
        }
        #vp-nav-hamburger span {
            display: block;
            width: 100%;
            height: 2px;
            background-color: rgb(59, 59, 51);
            border-radius: 1px;
            transition: background-color 0.3s ease;
        }
        @@media (max-width: 809px) {
            #vp-nav-center, #vp-nav-cta { display: none; }
            #vp-nav-hamburger { display: flex; }
        }
        @@media (min-width: 810px) and (max-width: 1137px) {
            #vp-nav-cta { display: none; }
            #vp-nav-hamburger { display: flex; }
        }

        /* ── Shared footer ── */
        #vp-footer {
            background-color: #223029;
            color: #fff;
            padding: 70px 0 54px;
        }
        #vp-footer-inner {
            max-width: 1366px;
            margin: 0 auto;
            padding: 0 24px;
        }
        #vp-footer-top {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            padding-bottom: 64px;
        }
        #vp-footer-brand {
            display: flex;
            flex-direction: column;
            gap: 36px;
        }
        #vp-footer-logo img {
            height: 62px;
            width: auto;
        }
        #vp-footer-tagline {
            font-family: "Season Sans Regular", "Season Sans Regular Placeholder", Arial, sans-serif;
            font-size: 15px;
            color: rgba(255,255,255,0.7);
            line-height: 1.5;
            max-width: 360px;
        }
        #vp-footer-links-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            align-self: start;
            justify-self: end;
        }
        .vp-footer-link-col {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }
        .vp-footer-link-col a {
            font-family: "Season Sans Regular", "Season Sans Regular Placeholder", Arial, sans-serif;
            font-size: 14px;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
        }
        .vp-footer-link-col a:hover { color: #fff; }
        #vp-footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid rgba(255,255,255,0.12);
            padding-top: 32px;
            flex-wrap: wrap;
            gap: 16px;
        }
        #vp-footer-legal {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        #vp-footer-legal span {
            font-family: "Season Sans Regular", "Season Sans Regular Placeholder", Arial, sans-serif;
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }
        #vp-footer-legal a {
            font-family: "Season Sans Regular", "Season Sans Regular Placeholder", Arial, sans-serif;
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        #vp-footer-legal a:hover { color: rgba(255,255,255,0.8); }
        #vp-footer-social {
            display: flex;
            align-items: center;
            gap: 24px;
        }
        #vp-footer-social a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            color: rgba(255,255,255,0.5);
            fill: rgba(255,255,255,0.5);
        }
        #vp-footer-social a:hover { fill: #fff; }
        #vp-footer-social svg { width: 18px; height: 18px; }
        @@media (max-width: 809px) {
            #vp-footer-top { grid-template-columns: 1fr; gap: 64px; }
            #vp-footer-links-grid {
                grid-template-columns: 1fr;
                gap: 32px;
                justify-self: start;
            }
            #vp-footer-bottom { flex-direction: column; align-items: flex-start; }
        }
        @@media (min-width: 810px) and (max-width: 1137px) {
            #vp-footer-top { grid-template-columns: 1fr; gap: 80px; }
            #vp-footer-links-grid { justify-self: start; }
        }
    </style>
    @RenderSection("HeadMeta", required: false)
    @RenderSection("HeadStyles", required: true)
</head>
