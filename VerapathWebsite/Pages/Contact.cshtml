@Html.AntiForgeryToken()

@section Scripts {
    <script>
    // Intercept the Framer contact form and POST to ASP.NET controller
    (function() {
        var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        function waitForForm() {
            var form = document.querySelector('form[class*="framer-"]');
            if (!form) {
                setTimeout(waitForForm, 200);
                return;
            }
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                var formData = new FormData();
                var inputs = form.querySelectorAll('input, textarea');
                inputs.forEach(function(input) {
                    if (input.name) formData.append(input.name, input.value);
                });
                formData.append('__RequestVerificationToken', antiForgeryToken || '');
                
                try {
                    var response = await fetch('/contact/submit', {
                        method: 'POST',
                        body: formData
                    });
                    if (response.ok) {
                        // Show success state
                        form.innerHTML = '<div style="padding:2rem;text-align:center;font-family:inherit;color:inherit"><h3>Thank you!</h3><p>We\'ll be in touch soon.</p></div>';
                    } else {
                        alert('There was an error sending your message. Please try again.');
                    }
                } catch (err) {
                    alert('There was an error sending your message. Please try again.');
                }
            }, true);
        }
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', waitForForm);
        } else {
            waitForForm();
        }
    })();
    </script>
}
